{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/suchipizza/pigtail/schemas/brief/v1.json",
  "title": "brief",
  "description": "A pigtail research brief, schema v1 (PRD R18.1, ADR-053, ADR-054). Briefs are private and live only in the instance's data directory (R18.9).",
  "$defs": {
    "Budget": {
      "additionalProperties": false,
      "description": "ADR-053.1: two separate caps; the LLM backend is never switched automatically.",
      "properties": {
        "money_usd": {
          "default": 0.0,
          "maximum": 100000,
          "minimum": 0,
          "title": "Money Usd",
          "type": "number"
        },
        "subscription_share": {
          "default": 0.5,
          "exclusiveMinimum": 0,
          "maximum": 1,
          "title": "Subscription Share",
          "type": "number"
        },
        "llm_backend": {
          "default": "subscription",
          "enum": [
            "subscription",
            "api"
          ],
          "title": "Llm Backend",
          "type": "string"
        },
        "llm_api_usd": {
          "default": 0.0,
          "maximum": 100000,
          "minimum": 0,
          "title": "Llm Api Usd",
          "type": "number"
        },
        "auto_switch_backend": {
          "const": false,
          "default": false,
          "title": "Auto Switch Backend",
          "type": "boolean"
        }
      },
      "title": "Budget",
      "type": "object"
    },
    "Channels": {
      "additionalProperties": false,
      "properties": {
        "planned": {
          "default": [],
          "items": {
            "pattern": "^[a-z][a-z0-9_]{0,39}$",
            "type": "string"
          },
          "title": "Planned",
          "type": "array"
        },
        "avoid": {
          "default": [],
          "items": {
            "pattern": "^[a-z][a-z0-9_]{0,39}$",
            "type": "string"
          },
          "title": "Avoid",
          "type": "array"
        },
        "details": {
          "default": {},
          "patternProperties": {
            "^[a-z][a-z0-9_]{0,39}$": {
              "items": {
                "maxLength": 500,
                "minLength": 1,
                "type": "string"
              },
              "type": "array"
            }
          },
          "title": "Details",
          "type": "object"
        }
      },
      "title": "Channels",
      "type": "object"
    },
    "Expansion": {
      "additionalProperties": false,
      "description": "R18.7: the LLM-proposed expansion, as edited by the user (part of the brief version).",
      "properties": {
        "problem_statement": {
          "anyOf": [
            {
              "maxLength": 2000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Problem Statement"
        },
        "users": {
          "default": [],
          "items": {
            "maxLength": 500,
            "minLength": 1,
            "type": "string"
          },
          "title": "Users",
          "type": "array"
        },
        "keywords": {
          "default": [],
          "items": {
            "maxLength": 500,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 40,
          "title": "Keywords",
          "type": "array"
        },
        "topics": {
          "default": [],
          "items": {
            "pattern": "^[a-z0-9][a-z0-9-]{0,49}$",
            "type": "string"
          },
          "maxItems": 40,
          "title": "Topics",
          "type": "array"
        },
        "competitors": {
          "default": [],
          "items": {
            "maxLength": 500,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 40,
          "title": "Competitors",
          "type": "array"
        },
        "generated_by": {
          "default": "user",
          "enum": [
            "user",
            "llm"
          ],
          "title": "Generated By",
          "type": "string"
        },
        "prompt_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Prompt Version"
        }
      },
      "title": "Expansion",
      "type": "object"
    },
    "Fallbacks": {
      "additionalProperties": false,
      "properties": {
        "no_measurable_adoption": {
          "default": "use_community_as_primary_and_flag",
          "enum": [
            "use_community_as_primary_and_flag",
            "fail_threshold",
            "skip_threshold"
          ],
          "title": "No Measurable Adoption",
          "type": "string"
        },
        "too_few_winners": {
          "$ref": "#/$defs/TooFewWinners",
          "default": {
            "min_winners": 10,
            "steps": [
              "relax_primary_to_top_third",
              "drop_community_minimum"
            ],
            "log_each_step": true,
            "report_sensitivity_check": true
          }
        }
      },
      "title": "Fallbacks",
      "type": "object"
    },
    "FieldBoundaries": {
      "additionalProperties": false,
      "description": "R18.1 `field`, R4.10 widening, R4.11 reference cases.",
      "properties": {
        "core_field": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Core Field",
          "type": "string"
        },
        "include": {
          "items": {
            "maxLength": 500,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 30,
          "minItems": 1,
          "title": "Include",
          "type": "array"
        },
        "exclude": {
          "default": [],
          "items": {
            "maxLength": 500,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 30,
          "title": "Exclude",
          "type": "array"
        },
        "seed_projects": {
          "default": [],
          "items": {
            "maxLength": 500,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 50,
          "title": "Seed Projects",
          "type": "array"
        },
        "reference_cases": {
          "default": [],
          "items": {
            "maxLength": 500,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 10,
          "title": "Reference Cases",
          "type": "array"
        },
        "reference_models": {
          "default": [],
          "items": {
            "maxLength": 500,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 10,
          "title": "Reference Models",
          "type": "array"
        },
        "widening_steps": {
          "default": [],
          "items": {
            "maxLength": 500,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 5,
          "title": "Widening Steps",
          "type": "array"
        }
      },
      "required": [
        "core_field",
        "include"
      ],
      "title": "FieldBoundaries",
      "type": "object"
    },
    "Geography": {
      "additionalProperties": false,
      "properties": {
        "scope": {
          "default": "global",
          "maxLength": 500,
          "minLength": 1,
          "title": "Scope",
          "type": "string"
        },
        "languages": {
          "default": [
            "en"
          ],
          "items": {
            "pattern": "^[a-z]{2,3}(-[A-Za-z0-9]{2,8})?$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Languages",
          "type": "array"
        },
        "later": {
          "default": [],
          "items": {
            "maxLength": 500,
            "minLength": 1,
            "type": "string"
          },
          "title": "Later",
          "type": "array"
        }
      },
      "title": "Geography",
      "type": "object"
    },
    "OptionalSources": {
      "additionalProperties": false,
      "description": "Optional, possibly paid sources; all off unless the user enables them (ADR-053.1).",
      "properties": {
        "trendshift": {
          "default": false,
          "title": "Trendshift",
          "type": "boolean"
        },
        "x": {
          "default": false,
          "title": "X",
          "type": "boolean"
        },
        "bigquery": {
          "default": false,
          "title": "Bigquery",
          "type": "boolean"
        }
      },
      "title": "OptionalSources",
      "type": "object"
    },
    "OwnAudience": {
      "additionalProperties": false,
      "description": "The user's own audience per channel, as CB-10 reach bands (a count becomes a band).",
      "properties": {
        "channels": {
          "default": {},
          "patternProperties": {
            "^[a-z][a-z0-9_]{0,39}$": {
              "enum": [
                "none",
                "r1",
                "r2",
                "r3",
                "r4",
                "unknown"
              ],
              "type": "string"
            }
          },
          "title": "Channels",
          "type": "object"
        },
        "note": {
          "anyOf": [
            {
              "maxLength": 500,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Note"
        }
      },
      "title": "OwnAudience",
      "type": "object"
    },
    "Panel": {
      "additionalProperties": false,
      "description": "R4.3, R4.8 (15\u201325 each, default 20/20), ADR-054.1 (exact match and SMD rules).",
      "properties": {
        "winners": {
          "default": 20,
          "maximum": 25,
          "minimum": 15,
          "title": "Winners",
          "type": "integer"
        },
        "losers": {
          "default": 20,
          "maximum": 25,
          "minimum": 15,
          "title": "Losers",
          "type": "integer"
        },
        "exact_match": {
          "default": [
            "founder_audience_bucket",
            "launch_half_year"
          ],
          "items": {
            "enum": [
              "founder_audience_bucket",
              "launch_half_year"
            ],
            "type": "string"
          },
          "title": "Exact Match",
          "type": "array"
        },
        "smd_target": {
          "default": 0.25,
          "exclusiveMinimum": 0,
          "maximum": 1,
          "title": "Smd Target",
          "type": "number"
        },
        "headline_exclusion_smd": {
          "default": 0.5,
          "exclusiveMinimum": 0,
          "maximum": 2,
          "title": "Headline Exclusion Smd",
          "type": "number"
        }
      },
      "title": "Panel",
      "type": "object"
    },
    "Project": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "maxLength": 120,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "description": {
          "maxLength": 2000,
          "minLength": 10,
          "title": "Description",
          "type": "string"
        },
        "target_users": {
          "$ref": "#/$defs/TargetUsers"
        },
        "business_model": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Business Model",
          "type": "string"
        },
        "context": {
          "anyOf": [
            {
              "maxLength": 2000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Context"
        }
      },
      "required": [
        "name",
        "description",
        "target_users",
        "business_model"
      ],
      "title": "Project",
      "type": "object"
    },
    "Success": {
      "additionalProperties": false,
      "description": "Success definition (R18.8, outcome-model v2 \u00a75\u20136, ADR-053.2).",
      "properties": {
        "primary": {
          "enum": [
            "attention",
            "adoption",
            "community",
            "business"
          ],
          "title": "Primary",
          "type": "string"
        },
        "primary_threshold": {
          "default": "top_quartile",
          "enum": [
            "none",
            "at_least_p25",
            "at_least_median",
            "top_third",
            "top_quartile",
            "top_decile"
          ],
          "title": "Primary Threshold",
          "type": "string"
        },
        "minimums": {
          "additionalProperties": {
            "enum": [
              "none",
              "at_least_p25",
              "at_least_median",
              "top_third",
              "top_quartile",
              "top_decile"
            ],
            "type": "string"
          },
          "default": {},
          "propertyNames": {
            "enum": [
              "attention",
              "adoption",
              "community"
            ]
          },
          "title": "Minimums",
          "type": "object"
        },
        "business_minimum": {
          "default": [],
          "items": {
            "enum": [
              "pricing_page",
              "hiring_hn_posts",
              "careers_roles"
            ],
            "type": "string"
          },
          "title": "Business Minimum",
          "type": "array"
        },
        "accept_self_reported": {
          "default": false,
          "title": "Accept Self Reported",
          "type": "boolean"
        },
        "metrics": {
          "additionalProperties": {
            "type": "string"
          },
          "default": {},
          "propertyNames": {
            "enum": [
              "attention",
              "adoption",
              "community",
              "business"
            ]
          },
          "title": "Metrics",
          "type": "object"
        },
        "if_not_applicable": {
          "additionalProperties": {
            "enum": [
              "fail",
              "skip"
            ],
            "type": "string"
          },
          "default": {},
          "propertyNames": {
            "enum": [
              "attention",
              "adoption",
              "community",
              "business"
            ]
          },
          "title": "If Not Applicable",
          "type": "object"
        },
        "weights": {
          "anyOf": [
            {
              "additionalProperties": {
                "maximum": 1,
                "minimum": 0,
                "type": "number"
              },
              "propertyNames": {
                "enum": [
                  "attention",
                  "adoption",
                  "community"
                ]
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Weights"
        },
        "sensitivity": {
          "default": [
            "primary_swap",
            "band_shift",
            "weights",
            "fake_star_filter"
          ],
          "items": {
            "enum": [
              "primary_swap",
              "band_shift",
              "weights",
              "fake_star_filter"
            ],
            "type": "string"
          },
          "title": "Sensitivity",
          "type": "array"
        },
        "fallbacks": {
          "$ref": "#/$defs/Fallbacks",
          "default": {
            "no_measurable_adoption": "use_community_as_primary_and_flag",
            "too_few_winners": {
              "log_each_step": true,
              "min_winners": 10,
              "report_sensitivity_check": true,
              "steps": [
                "relax_primary_to_top_third",
                "drop_community_minimum"
              ]
            }
          }
        }
      },
      "required": [
        "primary"
      ],
      "title": "Success",
      "type": "object"
    },
    "TargetUsers": {
      "additionalProperties": false,
      "properties": {
        "primary": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Primary",
          "type": "string"
        },
        "secondary": {
          "anyOf": [
            {
              "maxLength": 500,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Secondary"
        }
      },
      "required": [
        "primary"
      ],
      "title": "TargetUsers",
      "type": "object"
    },
    "TooFewWinners": {
      "additionalProperties": false,
      "description": "ADR-053.2: if fewer than `min_winners` qualify, apply `steps` in order.",
      "properties": {
        "min_winners": {
          "default": 10,
          "maximum": 25,
          "minimum": 1,
          "title": "Min Winners",
          "type": "integer"
        },
        "steps": {
          "default": [
            "relax_primary_to_top_third",
            "drop_community_minimum"
          ],
          "items": {
            "enum": [
              "relax_primary_to_top_third",
              "drop_attention_minimum",
              "drop_adoption_minimum",
              "drop_community_minimum",
              "drop_business_minimum"
            ],
            "type": "string"
          },
          "title": "Steps",
          "type": "array"
        },
        "log_each_step": {
          "const": true,
          "default": true,
          "title": "Log Each Step",
          "type": "boolean"
        },
        "report_sensitivity_check": {
          "const": true,
          "default": true,
          "title": "Report Sensitivity Check",
          "type": "boolean"
        }
      },
      "title": "TooFewWinners",
      "type": "object"
    },
    "Window": {
      "additionalProperties": false,
      "description": "Discovery and backfill window (R18.1, ADR-047.1: 12\u201318 months).",
      "properties": {
        "months": {
          "default": 18,
          "maximum": 18,
          "minimum": 12,
          "title": "Months",
          "type": "integer"
        },
        "end": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "End"
        }
      },
      "title": "Window",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "brief/v1",
      "default": "brief/v1",
      "title": "Schema Version",
      "type": "string"
    },
    "brief_id": {
      "pattern": "^[a-z0-9][a-z0-9-]{1,62}[a-z0-9]$",
      "title": "Brief Id",
      "type": "string"
    },
    "version": {
      "anyOf": [
        {
          "minimum": 1,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Version"
    },
    "supersedes": {
      "anyOf": [
        {
          "minimum": 1,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Supersedes"
    },
    "created_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Created At"
    },
    "edited_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Edited At"
    },
    "status": {
      "default": "draft",
      "enum": [
        "draft",
        "ready_for_discovery"
      ],
      "title": "Status",
      "type": "string"
    },
    "project": {
      "$ref": "#/$defs/Project"
    },
    "field": {
      "$ref": "#/$defs/FieldBoundaries"
    },
    "window": {
      "$ref": "#/$defs/Window",
      "default": {
        "months": 18,
        "end": null
      }
    },
    "success": {
      "$ref": "#/$defs/Success"
    },
    "own_audience": {
      "$ref": "#/$defs/OwnAudience",
      "default": {
        "channels": {},
        "note": null
      }
    },
    "channels": {
      "$ref": "#/$defs/Channels",
      "default": {
        "planned": [],
        "avoid": [],
        "details": {}
      }
    },
    "geography": {
      "$ref": "#/$defs/Geography",
      "default": {
        "scope": "global",
        "languages": [
          "en"
        ],
        "later": []
      }
    },
    "panel": {
      "$ref": "#/$defs/Panel",
      "default": {
        "winners": 20,
        "losers": 20,
        "exact_match": [
          "founder_audience_bucket",
          "launch_half_year"
        ],
        "smd_target": 0.25,
        "headline_exclusion_smd": 0.5
      }
    },
    "budget": {
      "$ref": "#/$defs/Budget",
      "default": {
        "money_usd": 0.0,
        "subscription_share": 0.5,
        "llm_backend": "subscription",
        "llm_api_usd": 0.0,
        "auto_switch_backend": false
      }
    },
    "optional_sources": {
      "$ref": "#/$defs/OptionalSources",
      "default": {
        "trendshift": false,
        "x": false,
        "bigquery": false
      }
    },
    "expansion": {
      "anyOf": [
        {
          "$ref": "#/$defs/Expansion"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "notes": {
      "anyOf": [
        {
          "maxLength": 4000,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Notes"
    }
  },
  "required": [
    "brief_id",
    "project",
    "field",
    "success"
  ],
  "type": "object",
  "x-cross-field-rules": [
    "field: include and exclude don't overlap",
    "success: the primary dimension has no entry in minimums (its floor is primary_threshold)",
    "success: primary business requires primary_threshold none (ranked by signal count)",
    "success.metrics: each metric is one of the allowed metrics for its dimension",
    "success.weights: sums to 1",
    "success.fallbacks.too_few_winners.steps: relax_primary_to_top_third needs a primary threshold stricter than top_third; drop_<dim>_minimum needs that minimum; no duplicates",
    "success.fallbacks.too_few_winners.min_winners <= panel.winners",
    "channels: planned and avoid don't overlap",
    "panel: headline_exclusion_smd > smd_target; exact_match has no duplicates"
  ]
}
