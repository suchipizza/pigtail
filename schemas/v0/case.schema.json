{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/suchipizza/pigtail/schemas/v0/case.schema.json",
  "title": "case",
  "description": "A growth episode under investigation (PRD §7, R1.1, R1.3).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "repo_id",
    "opened_at",
    "trigger",
    "status",
    "detection"
  ],
  "properties": {
    "schema_version": {
      "const": "v0"
    },
    "id": {
      "type": "string",
      "pattern": "^case_[0-9a-f]{20}$"
    },
    "repo_id": {
      "type": "string",
      "pattern": "^[a-z]+:[0-9]+$"
    },
    "opened_at": {
      "description": "Data time at which the case was opened (end of the detection hour for velocity cases).",
      "type": "string",
      "format": "date-time"
    },
    "closed_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "trigger": {
      "enum": [
        "velocity",
        "announced",
        "manual",
        "analyze"
      ]
    },
    "status": {
      "enum": [
        "live",
        "pre_launch",
        "closed"
      ]
    },
    "run_id": {
      "description": "Run that opened the case.",
      "type": [
        "string",
        "null"
      ]
    },
    "detection": {
      "description": "Detection metrics; required for velocity cases, null otherwise. velocity-v0 (GH Archive) or detection-v1 (ADR-032: GitHub counts + star-history).",
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/velocity_detection"
        },
        {
          "$ref": "#/$defs/velocity_detection_v1"
        }
      ]
    }
  },
  "$defs": {
    "velocity_detection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rule_version",
        "detected_hour",
        "stars_48h",
        "stars_48h_raw",
        "forks_48h",
        "baseline_mean_48h",
        "baseline_std_48h",
        "sigma_used",
        "z_score",
        "baseline_hours_covered",
        "baseline_quality",
        "threshold_min_stars",
        "threshold_sigma",
        "bot_filter_version",
        "coverage"
      ],
      "properties": {
        "rule_version": {
          "type": "string"
        },
        "detected_hour": {
          "description": "Start of the hour bucket that crossed the threshold.",
          "type": "string",
          "format": "date-time"
        },
        "stars_48h": {
          "description": "Bot-filtered stars in the trailing 48 h.",
          "type": "integer",
          "minimum": 0
        },
        "stars_48h_raw": {
          "type": "integer",
          "minimum": 0
        },
        "forks_48h": {
          "type": "integer",
          "minimum": 0
        },
        "baseline_mean_48h": {
          "type": "number",
          "minimum": 0
        },
        "baseline_std_48h": {
          "type": "number",
          "minimum": 0
        },
        "sigma_used": {
          "description": "Denominator actually used for z (after floors).",
          "type": "number",
          "exclusiveMinimum": 0
        },
        "z_score": {
          "type": "number"
        },
        "baseline_hours_covered": {
          "type": "integer",
          "minimum": 0,
          "maximum": 720
        },
        "baseline_quality": {
          "enum": [
            "full",
            "partial",
            "none"
          ]
        },
        "threshold_min_stars": {
          "type": "integer",
          "minimum": 0
        },
        "threshold_sigma": {
          "type": "number",
          "minimum": 0
        },
        "bot_filter_version": {
          "type": "string"
        },
        "coverage": {
          "$ref": "#/$defs/coverage"
        }
      }
    },
    "coverage": {
      "description": "How complete the star series behind this detection is. Event sources (GH Archive, per-repo events) may under-capture star events; thresholds are 'as observed in <source>'. reference_* are filled when an independent source was checked for the same window: since ADR-032 the GitHub star-history endpoint (reference_source \"github_star_history\"); records written before ADR-032 may name \"github_stargazers_api\".",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "window_start",
        "window_end",
        "observed_stars",
        "reference_stars",
        "reference_source",
        "ratio"
      ],
      "properties": {
        "source": {
          "description": "Star-series source the detection used.",
          "type": "string"
        },
        "window_start": {
          "type": "string",
          "format": "date-time"
        },
        "window_end": {
          "type": "string",
          "format": "date-time"
        },
        "observed_stars": {
          "description": "Raw stars observed in the source for the window.",
          "type": "integer",
          "minimum": 0
        },
        "reference_stars": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "reference_source": {
          "description": "Identifier of the reference source; free string, null when no reference was checked. Current value: github_star_history (ADR-032).",
          "type": [
            "string",
            "null"
          ],
          "examples": [
            "github_star_history"
          ]
        },
        "ratio": {
          "description": "observed_stars / reference_stars, null when no reference.",
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        }
      }
    },
    "velocity_detection_v1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rule_version",
        "detected_hour",
        "stars_48h",
        "stars_48h_raw",
        "forks_48h",
        "baseline_mean_48h",
        "baseline_std_48h",
        "sigma_used",
        "z_score",
        "baseline_hours_covered",
        "baseline_quality",
        "threshold_min_stars",
        "threshold_sigma",
        "bot_filter_version",
        "coverage",
        "data_sources",
        "window_hours_observed",
        "baseline_source",
        "baseline_days_covered",
        "day_boundary_tz",
        "bot_filter"
      ],
      "properties": {
        "rule_version": {
          "const": "detection-v1"
        },
        "detected_hour": {
          "description": "Start of the UTC hour of the count snapshot that crossed the threshold.",
          "type": "string",
          "format": "date-time"
        },
        "stars_48h": {
          "description": "Net stargazer-count change over the window (can be negative in principle).",
          "type": "integer"
        },
        "stars_48h_raw": {
          "type": "integer"
        },
        "forks_48h": {
          "type": "integer"
        },
        "baseline_mean_48h": {
          "type": "number",
          "minimum": 0
        },
        "baseline_std_48h": {
          "type": "number",
          "minimum": 0
        },
        "sigma_used": {
          "description": "Denominator actually used for z (after floors).",
          "type": "number",
          "exclusiveMinimum": 0
        },
        "z_score": {
          "type": "number"
        },
        "baseline_hours_covered": {
          "type": "integer",
          "minimum": 0,
          "maximum": 720
        },
        "baseline_quality": {
          "enum": [
            "full",
            "partial",
            "none"
          ]
        },
        "threshold_min_stars": {
          "type": "integer",
          "minimum": 0
        },
        "threshold_sigma": {
          "type": "number",
          "minimum": 0
        },
        "bot_filter_version": {
          "type": "string"
        },
        "coverage": {
          "$ref": "#/$defs/coverage"
        },
        "data_sources": {
          "description": "Sources behind this detection, e.g. github_graphql_counts, github_star_history.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "window_hours_observed": {
          "description": "Hours between the two count snapshots used (<= 48; shorter for repos new to the watch list).",
          "type": "number",
          "minimum": 0
        },
        "baseline_source": {
          "type": "string"
        },
        "baseline_days_covered": {
          "type": "integer",
          "minimum": 0
        },
        "day_boundary_tz": {
          "description": "Day boundaries of the star-history endpoint (documented only as not UTC-aligned; inferred US Pacific).",
          "type": "string"
        },
        "bot_filter": {
          "$ref": "#/$defs/bot_filter"
        }
      },
      "description": "detection-v1 (ADR-032, M1-T24): stars_48h is the net change of the public stargazer count over the window (hourly GraphQL snapshots); baseline from the star-history endpoint (daily, endpoint day labels, not UTC-aligned); baseline_hours_covered = baseline days x 24."
    },
    "bot_filter": {
      "description": "Bot/lockstep confirmation state of a detection-v1 case (ADR-032.2; outcome-model §2.1 bot_filter.basis / bot_filter.confirmed). coverage_ratio = identity-level stars seen / star-history net stars for the window.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "basis",
        "confirmed",
        "version",
        "layers",
        "updated_at",
        "stars_seen",
        "stars_bot",
        "stars_lockstep",
        "stars_filtered",
        "lockstep_hours",
        "events_from",
        "window_overflow",
        "coverage_ratio"
      ],
      "properties": {
        "status": {
          "enum": [
            "pending",
            "applied",
            "unavailable"
          ]
        },
        "basis": {
          "description": "Data the bot filter used (outcome-model §2.1 bot_filter.basis).",
          "enum": [
            "repo_events",
            "gharchive",
            "none"
          ]
        },
        "confirmed": {
          "description": "outcome-model §2.1 bot_filter.confirmed: null until applied; then whether the window still meets R1.1's absolute threshold after removing flagged stars.",
          "type": [
            "boolean",
            "null"
          ]
        },
        "version": {
          "type": "string"
        },
        "layers": {
          "description": "Bot-filter heuristics applied (login_rules; lockstep only where cross-repo activity is observable).",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "updated_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "stars_seen": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "stars_bot": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "stars_lockstep": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "stars_filtered": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "lockstep_hours": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "events_from": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "window_overflow": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "coverage_ratio": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        }
      }
    }
  }
}
