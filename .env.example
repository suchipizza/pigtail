# Copy to .env (never commit .env). The repo is public.

# --- LLM backends ---
# Product LLM calls: subscription (official `claude` CLI on your own Claude plan) | api (ANTHROPIC_API_KEY)
LLM_BACKEND=subscription
# Per-job overrides, e.g. run heavy extraction on the API while everything else stays on the subscription:
# LLM_BACKEND_OVERRIDES=tier2_extraction:api
# Agents that build pigtail (read by scripts/run-autonomous.sh): subscription | api
AGENT_BACKEND=subscription
# Headless subscription auth: generate it yourself with `claude setup-token`. Set this in the host environment, not in git.
# CLAUDE_CODE_OAUTH_TOKEN=
# Used only when a backend is set to api. If set, it overrides the subscription, so the runner and LLMClient strip it in subscription mode.
# ANTHROPIC_API_KEY=

# Model used for product LLM calls (both backends)
LLM_MODEL=claude-opus-5
# Seconds to pause a backend after a usage limit when no reset time is reported
LLM_LIMIT_PAUSE_SECONDS=1800

# --- Data sources ---
GITHUB_TOKEN=
GCP_PROJECT_ID=
GOOGLE_APPLICATION_CREDENTIALS=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=pigtail/0.1 (+https://github.com/suchipizza/pigtail)

# --- Storage ---
# Local working data (LLM cache/ledger, raw captures). Never inside a git-tracked path other than data/ (gitignored).
PIGTAIL_DATA_DIR=data
POSTGRES_USER=pigtail
POSTGRES_PASSWORD=pigtail
POSTGRES_DB=pigtail
DATABASE_URL=postgresql://pigtail:pigtail@localhost:5432/pigtail
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=pigtail-snapshots
S3_ACCESS_KEY=pigtail-local
S3_SECRET_KEY=pigtail-local-secret
# Keyed hash for handles (>= 16 chars). Store it separately from the data; losing it breaks pseudonym stability.
PSEUDONYM_KEY=

# --- Ops ---
BUDGET_USD_MONTH=300
ALERT_EMAIL=
SMTP_URL=
