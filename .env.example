# Copy to .env (never commit .env). The repo is public.

# --- LLM backends ---
# Product LLM calls: subscription (official `claude` CLI on your own Claude plan) | api (ANTHROPIC_API_KEY)
LLM_BACKEND=subscription
# Per-job overrides, e.g. run heavy extraction on the API while everything else stays on the subscription:
# LLM_BACKEND_OVERRIDES=tier2_extraction:api
# Agents that build pigtail (read by scripts/run-autonomous.sh): subscription | api
AGENT_BACKEND=subscription
# Headless subscription auth: generate it yourself with `claude setup-token`. Set this in the host environment, not in git.
# CLAUDE_CODE_OAUTH_TOKEN=
# Used only when a backend is set to api. If set, it overrides the subscription, so the runner and LLMClient strip it in subscription mode.
# ANTHROPIC_API_KEY=

# Model used for product LLM calls (both backends)
LLM_MODEL=claude-opus-5
# Seconds to pause a backend after a usage limit when no reset time is reported
LLM_LIMIT_PAUSE_SECONDS=1800

# --- Data sources ---
GITHUB_TOKEN=
GCP_PROJECT_ID=
GOOGLE_APPLICATION_CREDENTIALS=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=pigtail/0.1 (+https://github.com/suchipizza/pigtail)

# --- Storage ---
# Local working data (LLM cache/ledger, raw captures). Never inside a git-tracked path other than data/ (gitignored).
PIGTAIL_DATA_DIR=data
POSTGRES_USER=pigtail
POSTGRES_PASSWORD=pigtail
POSTGRES_DB=pigtail
DATABASE_URL=postgresql://pigtail:pigtail@localhost:5432/pigtail
# Snapshot store: local (PIGTAIL_DATA_DIR/snapshots) | s3 (the bucket below)
SNAPSHOT_BACKEND=local
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=pigtail-snapshots
S3_ACCESS_KEY=pigtail-local
S3_SECRET_KEY=pigtail-local-secret
# DPIA CB-03: server-side encryption key (KEK) for the bundled SeaweedFS, 64 hex chars
# (`openssl rand -hex 32`). Empty = SSE off. Set it in the host environment and back it up apart
# from the data; losing it makes encrypted snapshots unreadable. `pigtail doctor` checks the bucket.
# S3_SSE_KEK=
# Keyed hash for handles (>= 16 chars). Store it separately from the data; losing it breaks pseudonym stability.
# CB-25: the database records a fingerprint of this key on first use and every capture/privacy
# command refuses to run under a different key. Never change it outside the key-rotation runbook.
# The `ui` compose service never receives it (CB-29).
PSEUDONYM_KEY=

# --- Connectors ---
# Per-source enable flag (R2.1): PIGTAIL_CONNECTOR_<NAME>_ENABLED=true|false (default per connector).
# A connector whose terms clearance is "gap" can never be enabled (R2.3).
# PIGTAIL_CONNECTOR_GHARCHIVE_ENABLED=true
# Hacker News mention capture (hn_algolia + hn_firebase; person-level). Off by default. Turning it
# on fails unless PIGTAIL_ADR022_PERSON_SOURCES_OK=1, which the operator sets only after every
# ADR-022 precondition for person-level sources (CB-01, 02, 03, 06, 08, 12, 13) is met.
PIGTAIL_ENABLE_HN=0
# PIGTAIL_ADR022_PERSON_SOURCES_OK=0
# HN front-page rank poller (project-level only; on by default, no ADR-022 flag needed).
# PIGTAIL_CONNECTOR_HN_RANKS_ENABLED=true
# Days to keep raw GH Archive hourly dumps after parsing (DPIA CB-04). Hash + URL are kept; replay
# re-downloads and verifies the hash. 0 = drop at the next purge. Maximum 30 (CB-32).
GHARCHIVE_RAW_RETENTION_DAYS=30

# --- Retention (docs/compliance/retention-policy.md; `pigtail retention purge`) ---
# Shorter periods are allowed; longer ones are rejected at startup.
# Person-level evidence: raw bytes dropped after this many days from fetched_at (CB-01, max 730).
PERSON_LEVEL_RETENTION_DAYS=730
# LLM cache rows expire after this many days from created_at (CB-05, max 730).
LLM_CACHE_RETENTION_DAYS=730
# `runs.error` text is cleared and UI audit rows are deleted after this many days (CB-18, CB-33, max 365).
LOG_RETENTION_DAYS=365

# --- Ops ---
BUDGET_USD_MONTH=300
# Alerts (M1-T21): always written to PIGTAIL_DATA_DIR/alerts/ (never committed). E-mail is sent
# too when both are set. SMTP_URL: smtp://host[:25] | smtp+starttls://user:pass@host:587 |
# smtps://user:pass@host:465. ALERT_EMAIL: comma-separated recipients.
ALERT_EMAIL=
SMTP_URL=
# ALERT_EMAIL_FROM=
# Scheduler (`pigtail scheduler run`): schedule file and /healthz endpoint.
# PIGTAIL_SCHEDULE=infra/schedule.toml
# PIGTAIL_HEALTH_BIND=127.0.0.1
# PIGTAIL_HEALTH_PORT=8787
# docker compose `scheduler` service only: use external services instead of `db` / `objectstore`.
# COMPOSE_DATABASE_URL=
# COMPOSE_S3_ENDPOINT=

# --- Web app (D1 preview; `pigtail ui serve`, docs/guides/operator.md "Web app") ---
# Required: argon2id hash from `pigtail ui hash-password`. Single-quote it (it contains `$`).
# PIGTAIL_OPERATOR_PASSWORD_HASH='$argon2id$...'
# PIGTAIL_UI_SESSION_HOURS=12
# PIGTAIL_UI_IDLE_MINUTES=120
# auto = Secure cookie unless reached on localhost; set 1 behind a TLS reverse proxy.
# PIGTAIL_UI_SECURE_COOKIE=auto
# Per-repo GitHub events (off by default): actor-row retention in days, default 16, ceiling 30 (ADR-038)
# GITHUB_EVENTS_RETENTION_DAYS=16
